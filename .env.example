# ========================================================
# Persistent Data Layer - Environment Configuration
# ========================================================

# Application Settings
APP_NAME=Persistent Data Layer
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL recommended for production)
# Standard format: postgresql+psycopg://<username>:<password>@<host>:5432/<database>
DATABASE_URL=postgresql+psycopg://<username>:<password>@<host>:5432/<database>

# Optional SQLite configuration for local offline testing and process-restart persistence:
# DATABASE_URL=sqlite:///./persistent_data.db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Data Seeding on Startup (true to populate sample users/projects/tasks if DB is empty)
SEED_DATA_ON_STARTUP=true
